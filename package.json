{
  "name": "bill-folder-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:e2e": "node scripts/verify-node-version.mjs && ng serve --configuration e2e --host 127.0.0.1 --port 4200",
    "build": "ng build",
    "build:prod": "ng build --configuration production && npm run test:artifacts",
    "build:preview": "ng build --configuration preview",
    "generate:brand-icons": "node scripts/generate-brand-icons.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false && npm run test:static",
    "test:static": "node --test tests/static-security.test.mjs",
    "test:artifacts": "node --test tests/built-artifacts.test.mjs",
    "e2e": "tsc -p tsconfig.e2e.json && playwright test",
    "e2e:ui": "playwright test --ui",
    "audit:ci": "npm audit --audit-level=high"
  },
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.2",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.1",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
