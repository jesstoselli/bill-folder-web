{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BillFolder",
  "version": "0.1.0",
  "identifier": "app.billfolder.desktop",
  "build": {
    "devUrl": "http://localhost:4200",
    "frontendDist": "https://preview.billfolder.app",
    "beforeDevCommand": "npm start"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Finance",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
